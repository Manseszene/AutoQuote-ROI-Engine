# OpenAI
OPENAI_API_KEY=sk-your-api-key
OPENAI_TEXT_MODEL=gpt-4o-mini
OPENAI_VISION_MODEL=gpt-4o

# Currency conversion defaults
BASE_CURRENCY=KRW
USD_KRW_RATE=1380.00
VND_KRW_RATE=0.054

# Runtime paths
INPUT_DIR=data/input
MASTER_DATA_DIR=data/master
NORMALIZED_OUTPUT_DIR=data/normalized
REPORT_OUTPUT_DIR=reports
CHART_OUTPUT_DIR=reports/charts
LOG_DIR=logs

# Parsing options
ENABLE_OCR_FALLBACK=true
TESSERACT_CMD=
POPPLER_BIN_PATH=

# Business defaults
DEFAULT_VOLUME_START=1000
DEFAULT_VOLUME_END=100000
DEFAULT_VOLUME_STEP=1000
DEFAULT_VAT_INCLUDED=false

# Standard cost schema
# Final calculated unit cost = Material + Processing + Management/Overhead + Local Tax + Profit 1 + Profit 2
STANDARD_COST_CATEGORIES=material,processing,management_overhead,local_tax,profit_1,profit_2
